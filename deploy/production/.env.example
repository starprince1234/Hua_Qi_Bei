# 镜像标签
BACKEND_TAG=v1
FRONTEND_TAG=v1

# 后端真实模型服务配置（生产）
# 方案B：OpenAI 兼容协议，后端将调用 /v1/chat/completions
MODEL_API_URL=http://host.docker.internal:6006/v1
MODEL_API_KEY=
MODEL_API_MODEL_ID=oil_vol_model
MODEL_API_TIMEOUT=120
MODEL_API_MAX_RETRIES=2
USE_MOCK_MODEL=false

# LLM（若生产需要）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_ID=Pro/deepseek-ai/DeepSeek-V3.2

# 前端公开 API 基址（经 nginx 反代后可用 /api）
NEXT_PUBLIC_API_URL=/api
FRONTEND_PORT=80
HOST_HTTP_BIND=127.0.0.1
HOST_HTTP_PORT=18080
HOST_HTTPS_BIND=127.0.0.1
HOST_HTTPS_PORT=18443

# 新闻事件与回测扩展（真实值必须存入 Doppler 或部署平台密钥）
DATABASE_URL=your_database_url_here
NEWS_PROVIDER=hybrid
NEWS_REFRESH_INTERVAL_MINUTES=30
GDELT_BIGQUERY_PROJECT_ID=your_google_cloud_project_id_here
GDELT_GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your_google_cloud_project_id_here"}
GDELT_BIGQUERY_MAX_BYTES_BILLED=1073741824
NEWSAPI_API_KEY=your_newsapi_api_key_here
HTTP_PROXY=http://mihomo:7890
HTTPS_PROXY=http://mihomo:7890
NO_PROXY=localhost,127.0.0.1,backend,frontend,nginx,mihomo
MIHOMO_CONFIG_PATH=/opt/mihomo/config.docker.yaml
MIHOMO_TAG=v1.19.27

# AutoDL SSH 隧道参数（供 setup_autodl_tunnel.sh 使用）
AUTODL_SSH_HOST=region-9.autodl.pro
AUTODL_SSH_PORT=50954
AUTODL_SSH_USER=root
AUTODL_SSH_PASSWORD=your_autodl_ssh_password_here
AUTODL_LOCAL_PORT=6006
AUTODL_REMOTE_HOST=127.0.0.1
AUTODL_REMOTE_PORT=6006

# GitHub Actions -> SSH deployment. Real values belong in Doppler prd.
DEPLOY_HOST=your_server_ip_here
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASSWORD=your_ssh_password_here
DEPLOY_PATH=/opt/huaqibei/app
DEPLOY_BRANCH=main
REPO_URL=https://github.com/your-org/your-repo.git
CERTS_DIR=/opt/huaqibei/deploy/production/certs
