# Local Docker Compose configuration
# Copy this file to .env when running docker compose from the repository root.

# Frontend public backend API URL. This is not a secret.
NEXT_PUBLIC_API_URL=http://localhost:18000
FRONTEND_PORT=13289

# Optional LLM report generation key. Leave empty to use rule/template fallback.
LLM_API_KEY=your_llm_api_key_here

# Remote model inference. Real values must be stored in Doppler.
USE_MOCK_MODEL=false
MODEL_API_URL=http://host.docker.internal:6006/v1
MODEL_API_TIMEOUT=120
MODEL_API_MAX_RETRIES=2
MODEL_API_KEY=your_model_api_key_here
MODEL_API_MODEL_ID=oil_vol_model

# AutoDL SSH tunnel. Real password must be stored in Doppler only.
AUTODL_SSH_HOST=region-9.autodl.pro
AUTODL_SSH_PORT=50954
AUTODL_SSH_USER=root
AUTODL_SSH_PASSWORD=your_autodl_ssh_password_here
AUTODL_LOCAL_PORT=6006
AUTODL_REMOTE_HOST=127.0.0.1
AUTODL_REMOTE_PORT=6006
AUTODL_PLINK_PATH=D:\PuTTY\plink.exe

# Optional news/backtest/factor-history extensions. Real values must be stored in Doppler.
DATABASE_URL=your_database_url_here # PostgreSQL connection string; keep placeholder for demo mode
REDIS_URL=redis://localhost:6379/0 # Redis cache connection string for future cached provider reads
CACHE_TTL_SECONDS=3600 # Cache TTL in seconds for intelligence payloads
NEWS_PROVIDER=mock # mock=deterministic demo fixtures; gdelt/newsapi/hybrid require backend credentials
NEWS_REFRESH_INTERVAL_MINUTES=30 # News scheduler refresh interval in minutes
GDELT_BIGQUERY_PROJECT_ID=your_gcp_project_id # Google Cloud project for GDELT BigQuery live mode
GDELT_GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your_gcp_project_id"} # Google service account JSON as one Doppler secret; placeholder only
GDELT_BIGQUERY_MAX_BYTES_BILLED=1073741824 # BigQuery max bytes billed per query, about 1 GiB
NEWSAPI_API_KEY=your_newsapi_key_here # NewsAPI fallback key; never expose to frontend

# GitHub Actions production deployment. Store real values in Doppler prd only.
DEPLOY_HOST=your_server_ip_here
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASSWORD=your_ssh_password_here
DEPLOY_PATH=/opt/huaqibei/app
DEPLOY_BRANCH=main
REPO_URL=https://github.com/your-org/your-repo.git
CERTS_DIR=/opt/huaqibei/deploy/production/certs
BACKEND_TAG=prd
FRONTEND_TAG=prd
HOST_HTTP_BIND=127.0.0.1
HOST_HTTP_PORT=18080
HOST_HTTPS_BIND=127.0.0.1
HOST_HTTPS_PORT=18443
