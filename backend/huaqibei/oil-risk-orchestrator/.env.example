# Oil Risk Intelligence Orchestrator - 环境配置
# 复制此文件为 .env 并填写实际值

# ─── 应用基础 ──────────────────────────────────────────────────────
APP_NAME=Oil Risk Intelligence Orchestrator
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# ─── 服务器 ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── 云端模型 API ──────────────────────────────────────────────────
# 将此处替换为你队友部署的模型 API 地址
MODEL_API_URL=http://localhost:9000/predict
MODEL_API_TIMEOUT=30
MODEL_API_MAX_RETRIES=3
MODEL_API_KEY=your_model_api_key_here

# ─── Mock 模式开关（true = 不调用真实模型，用随机数据）──────────────
USE_MOCK_MODEL=true

# ─── LLM 报告生成（SiliconFlow Chat Completions）──────────────────
LLM_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_ID=Pro/deepseek-ai/DeepSeek-V3.2
LLM_JSON_MODE=true
LLM_LORA_ID=
LLM_SEARCH_DISABLE=true
LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=4096
LLM_TOP_P=0.7
LLM_TOP_K=50
LLM_FREQUENCY_PENALTY=0.2
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
INDUSTRY_LLM_ENABLED=false

# ─── 分模块 LLM 模型 ──────────────────────────────────────────────
LLM_MODEL_RISK_LEVEL=Pro/deepseek-ai/DeepSeek-V3.2
LLM_MODEL_INDUSTRY_IMPACT=deepseek-ai/DeepSeek-V3.2
LLM_MODEL_KNOWLEDGE_GRAPH=deepseek-ai/DeepSeek-V3.1-Terminus
LLM_MODEL_REPORT_SUMMARY=Pro/deepseek-ai/DeepSeek-V3.1-Terminus
LLM_MODEL_FINANCING_RECOMMENDATION=Qwen/Qwen3.5-397B-A17B

# ─── 风险阈值 ──────────────────────────────────────────────────────
RISK_LOW_THRESHOLD=0.03
RISK_MEDIUM_THRESHOLD=0.07
